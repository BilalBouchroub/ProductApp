# Copiez ce fichier vers backend/.env. Ne versionnez jamais le jeton API.
EMAIL_PROVIDER=MailtrapApi
MAILTRAP_API_BASE_URL=https://send.api.mailtrap.io/
MAILTRAP_API_TOKEN=your-mailtrap-api-token
MAILTRAP_FROM_EMAIL=your-verified-sender@example.com
PLATFORM_NAME=ProductApp
PLATFORM_URL=http://localhost:5173

# SMART PRODUCT — Gemini est le fournisseur par défaut.
SMART_PRODUCT_PROVIDER=Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Repli facultatif :
# SMART_PRODUCT_PROVIDER=OpenAI
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-5.6
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
